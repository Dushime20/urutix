###############################################################################
# UrutiX — Production Environment Variables
#
# Copy this file to .env on the production server and fill in every value.
# Lines starting with # are comments / documentation — not loaded by the app.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
###############################################################################


# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=postgres          # Docker service name; use hostname for managed DB
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_strong_random_password
DB_NAME=urutix

# SSL — set to true for managed Postgres (Render, RDS, Supabase, Neon, etc.)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false   # set true when you control the CA

# Connection pool (defaults are production-safe; tune for your workload)
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_ACQUIRE_TIMEOUT_MS=10000

# Log queries slower than this threshold (ms) — 0 to disable
DB_SLOW_QUERY_MS=2000


# ── Migrations ────────────────────────────────────────────────────────────────
# AUTO_MIGRATE=true  → migrate.js runs on every container start (safe — idempotent)
# AUTO_MIGRATE=false → you run migrations manually before deploying
AUTO_MIGRATE=true

# If migrations fail and this is true the container exits (recommended for prod)
FAIL_ON_MIGRATION_ERROR=true


# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis          # Docker service name
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_random_password
REDIS_DB=0
REDIS_TLS=false


# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED — minimum 64 characters each, completely independent values
JWT_SECRET=CHANGE_ME_min_64_chars_random_hex
JWT_REFRESH_SECRET=CHANGE_ME_min_64_chars_random_hex_different_from_above

# Token lifetimes (minutes for access, days for refresh)
JWT_ACCESS_TOKEN_EXPIRY=1440
JWT_REFRESH_TOKEN_EXPIRY=30
JWT_REFRESH_DEFAULT_EXPIRY=7


# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3005
LOG_LEVEL=warn            # error | warn | log | debug | verbose


# ── URLs & CORS ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://urutix.com
BACKEND_URL=https://urutix.com/api
API_URL=https://urutix.com/api
ALLOWED_ORIGINS=https://urutix.com


# ── Frontend (Vite build-time args — not loaded by backend) ──────────────────
VITE_API_BASE_URL=https://urutix.com/api
VITE_WEBSOCKET_URL=wss://urutix.com
FRONTEND_PORT=5173


# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587             # 587 (STARTTLS) or 465 (TLS)
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@urutix.com


# ── Mobile Money ──────────────────────────────────────────────────────────────
MOBILE_MONEY_API_URL=https://api.payment.ishema.rw
MOBILE_MONEY_API_KEY=CHANGE_ME_mobile_money_api_key
MOBILE_MONEY_CALLBACK_URL=https://urutix.com/api/payments/webhooks/mobile-money
MOBILE_MONEY_CURRENCY=RWF
MOBILE_MONEY_ACCOUNT_PHONE=250788309463

# REQUIRED in production — prevents unauthenticated callers from spoofing
# payment confirmations via the webhook endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOBILE_MONEY_WEBHOOK_SECRET=CHANGE_ME_min_32_chars_random_hex


# ── Public Contact Info (landing page / emails) ───────────────────────────────
CONTACT_PHONE=+250788309463
CONTACT_EMAIL=hello@urutix.com
CONTACT_ADDRESS=Kigali, Rwanda


# ── Optional ──────────────────────────────────────────────────────────────────
# UUID of default tenant for open registration flows
# DEFAULT_TENANT_ID=
