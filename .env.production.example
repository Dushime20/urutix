# ================================
# Production Environment Variables
# ================================

# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here
DB_NAME=urutix
DB_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=0
REDIS_TLS=false
REDIS_PORT=6380

# JWT Secrets — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_min_64_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_64_chars
JWT_ACCESS_TOKEN_EXPIRY=1440
JWT_REFRESH_TOKEN_EXPIRY=30
JWT_REFRESH_DEFAULT_EXPIRY=7

# Backend Configuration
BACKEND_PORT=3005
NODE_ENV=production

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=https://urutix.com/api
VITE_WEBSOCKET_URL=wss://urutix.com

# CORS Configuration (comma-separated list)
ALLOWED_ORIGINS=https://urutix.com,http://localhost:5173

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_SECURE=true
# Optional: override "from" address in emails (defaults to SMTP_USER)
SMTP_FROM=noreply@urutix.com

# Mobile Money API Configuration
MOBILE_MONEY_API_URL=https://api.payment.ishema.rw
MOBILE_MONEY_API_KEY=your_mobile_money_api_key
MOBILE_MONEY_CALLBACK_URL=https://urutix.com/api/payments/webhooks/mobile-money
MOBILE_MONEY_CURRENCY=RWF
MOBILE_MONEY_ACCOUNT_PHONE=250788309463

# Frontend & Backend URLs — REQUIRED
FRONTEND_URL=https://urutix.com
BACKEND_URL=https://urutix.com/api
API_URL=https://urutix.com/api

# Public contact info (shown on landing page, no hardcoded fallbacks)
CONTACT_PHONE=+250788309463
CONTACT_EMAIL=hello@urutix.com
CONTACT_ADDRESS=Kigali, Rwanda

# Optional: UUID of default tenant for open registration
# DEFAULT_TENANT_ID=

# Migration Configuration
# Set to true to automatically run migrations on container start
AUTO_MIGRATE=false
# Set to true to fail container startup if migrations fail
FAIL_ON_MIGRATION_ERROR=true
