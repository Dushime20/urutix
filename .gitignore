# .gitignore for CargoAI Matching
# Node modules
node_modules/

# Build output
dist/
build/

# Logs
*.log
logs/

# Environment variables
.env
.env.*

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# SQLite database
*.sqlite

# Coverage
coverage/

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Old services logs
oldservices/**/logs/

# Large video files
*.mp4
frontend/public/*.mp4

# Documentation and status files (excluding README.md and CHANGELOG.md)
*_STATUS.md
*_SUMMARY.md
*_COMPLETE.md
*_FIX.md
*_IMPLEMENTATION.md
*_GUIDE.md
*_README.md
*_CHECKLIST.md
AUCTION_*.md
BIDDING_*.md
CREDIT_*.md
FLEET_*.md
LOAD_*.md
PROFESSIONAL_*.md
QUICK_*.md
START_HERE.md
TASK_*.md
TYPESCRIPT_*.md
VISUAL_*.md
AI_*.md
DEPLOYMENT_CHECKLIST.md
IMPLEMENTATION_*.md
FILES_CHANGED_SUMMARY.md
FINAL_SUMMARY.md
CHANGES_SUMMARY.md
COMPLETE_*.md
backend/BIDDING_SERVICE_VALIDATION_PATCH.md
