# .gitignore for CargoAI Matching
# Node modules
node_modules/

# Build output
dist/
build/

# Logs
*.log
logs/

# Environment variables
.env
.env.*

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# SQLite database
*.sqlite

# Coverage
coverage/

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Old services logs
oldservices/**/logs/

# Large video files
*.mp4
frontend/public/*.mp4

# Documentation and status files (excluding README.md and important docs)
# Exclude all .md files in root except specific ones
/*.md
!README.md
!CHANGELOG.md
!LICENSE.md
!CONTRIBUTING.md

# Exclude .md files in backend
backend/*.md
backend/**/*.md
!backend/README.md
